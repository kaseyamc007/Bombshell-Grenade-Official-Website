<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="800" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a0d" />
      <stop offset="45%" stop-color="#141118" />
      <stop offset="100%" stop-color="#1c0f0a" />
    </linearGradient>
    <radialGradient id="glowGrad" cx="50%" cy="45%" r="55%">
      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.32" />
      <stop offset="50%" stop-color="#dc2626" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="flameGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#dc2626" />
      <stop offset="50%" stop-color="#ea580c" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
    <linearGradient id="goldText" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="50%" stop-color="#fef08a" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
    <pattern id="gridPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#26232d" stroke-width="0.75" stroke-opacity="0.4" />
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="800" fill="url(#bgGrad)" />
  <rect width="800" height="800" fill="url(#gridPattern)" />
  <rect width="800" height="800" fill="url(#glowGrad)" />

  <!-- Outer Frame Border -->
  <rect x="24" y="24" width="752" height="752" rx="8" fill="none" stroke="#37313f" stroke-width="1.5" />
  <rect x="32" y="32" width="736" height="736" rx="6" fill="none" stroke="url(#flameGrad)" stroke-width="1" stroke-opacity="0.45" stroke-dasharray="8 6" />

  <!-- Corner Brackets -->
  <path d="M24 60 V24 H60" stroke="#f59e0b" stroke-width="3" fill="none"/>
  <path d="M776 60 V24 H740" stroke="#f59e0b" stroke-width="3" fill="none"/>
  <path d="M24 740 V776 H60" stroke="#f59e0b" stroke-width="3" fill="none"/>
  <path d="M776 740 V776 H740" stroke="#f59e0b" stroke-width="3" fill="none"/>

  <!-- Center Decorative Crest -->
  <g transform="translate(350, 275) scale(1)">
    <circle cx="50" cy="50" r="38" fill="none" stroke="url(#flameGrad)" stroke-width="4"/>
               <circle cx="50" cy="50" r="14" fill="#141418" stroke="#f59e0b" stroke-width="2"/>
               <path d="M46 38 V 62 L 62 50 Z" fill="#fbbf24"/>
  </g>

  <!-- Category Tag -->
  <g transform="translate(400, 375)">
    <rect x="-140" y="-14" width="280" height="28" rx="14" fill="#1e1822" stroke="#ea580c" stroke-width="1" />
    <text x="0" y="4" text-anchor="middle" fill="#fbbf24" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="3">FEATURED SINGLE â€¢ 1:1 Square</text>
  </g>

  <!-- Main Replacement Title -->
  <text x="400" y="435" text-anchor="middle" fill="#ffffff" font-family="'Cinzel', 'Montserrat', 'Playfair Display', Georgia, serif" font-size="30.4" font-weight="800" letter-spacing="1.5">
    REPLACE: Jump Off Single Cover
  </text>

  <!-- Drag and drop instruction -->
  <g transform="translate(400, 475)">
    <rect x="-240" y="-15" width="480" height="30" rx="4" fill="#000000" fill-opacity="0.6" stroke="#44394e" stroke-width="1" />
    <text x="0" y="5" text-anchor="middle" fill="#e2e8f0" font-family="monospace, sans-serif" font-size="12" letter-spacing="0.5">
      â†µ Target File: /src/single-jump-off.jpg
    </text>
  </g>

  <!-- Footnote -->
  <text x="400" y="752" text-anchor="middle" fill="#94a3b8" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" letter-spacing="0.5">
    Source photos from official Facebook: web.facebook.com/BombshellGrenade
  </text>
</svg>